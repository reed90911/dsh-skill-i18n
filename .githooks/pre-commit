#!/bin/sh
# pre-commit：提交前扫描敏感信息（手机号、邮箱、各类密钥）。
#
# 启用方式（克隆后执行一次）：
#   git config core.hooksPath .githooks
#
# 确认无误需要跳过时：
#   git commit --no-verify
#
# 单独手动跑：
#   node scripts/sensitive-scan.mjs .

set -u

# 统一在仓库根用相对路径操作。
# 注意：git for Windows 传给 node 的绝对路径可能是 MSYS 风格（/c/...），
# 原生 Windows node 不认，会被当成"文件不存在"而静默放行。
cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" || exit 0

SCANNER="scripts/sensitive-scan.mjs"

if [ ! -f "$SCANNER" ]; then
  echo "[pre-commit] 找不到 $SCANNER，跳过扫描"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 node，跳过敏感信息扫描"
  echo "[pre-commit] 建议手动执行：node scripts/sensitive-scan.mjs ."
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  exit 0
fi

OUT=$(mktemp 2>/dev/null || echo "./.git/sensitive-scan.out")
FOUND=0

for f in $STAGED; do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zip|*.tgz|*.exe|*.dll|*.node|*.asar)
      continue
      ;;
  esac
  [ -f "$f" ] || continue

  if node "$SCANNER" "$f" >"$OUT" 2>&1; then
    continue
  fi

  if [ "$FOUND" = "0" ]; then
    echo ""
    echo "┌──────────────────────────────────────────────────────────────┐"
    echo "│  提交被拦截：待提交文件里发现疑似敏感信息                     │"
    echo "└──────────────────────────────────────────────────────────────┘"
  fi
  FOUND=1
  echo ""
  echo "文件：$f"
  sed 's/^/  /' "$OUT"
done

rm -f "$OUT"

if [ "$FOUND" = "1" ]; then
  echo ""
  echo "处理方式："
  echo "  1. 删除敏感内容或改成占位符，重新 git add"
  echo "  2. 文件本就不该提交：git restore --staged <文件> 并加入 .gitignore"
  echo "  3. 确认是误报：git commit --no-verify"
  echo ""
  exit 1
fi

exit 0

{
  "name": "dsh-skill-i18n",
  "version": "2.1.0",
  "description": "把 DSH 技能描述翻译成中文：可选预制翻译表（零消耗）或模型实时翻译，扫描频率可配（每小时/每天/启动时/自定义），支持只翻译指定技能与两级回滚，并在设置页中可视化控制。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "i18n",
    "translation",
    "chinese"
  ],
  "license": "MIT",
  "author": "reed9",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reed90911/dsh-skill-i18n.git"
  },
  "homepage": "https://github.com/reed90911/dsh-skill-i18n#readme",
  "bugs": {
    "url": "https://github.com/reed90911/dsh-skill-i18n/issues"
  }
}
